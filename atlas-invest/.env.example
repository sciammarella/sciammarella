# ─── Banco de dados ────────────────────────────────────────────────────────────
# Deixe vazio para usar PGlite (Postgres embutido em WASM, persistido em ./.data/pglite).
# Para Postgres/Supabase: postgres://user:pass@host:5432/db
DATABASE_URL=
# Diretório do PGlite quando DATABASE_URL está vazio
PGLITE_DIR=./.data/pglite

# ─── Sessão ───────────────────────────────────────────────────────────────────
# Segredo para assinar cookies de sessão (obrigatório em produção; 32+ caracteres)
SESSION_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more

# ─── IA (opcional) ────────────────────────────────────────────────────────────
# Sem chave, o agente usa o modo "analista por regras" (determinístico, sem LLM).
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ─── Dados de mercado ─────────────────────────────────────────────────────────
# "live" tenta provedores reais (BCB, Tesouro EUA, CoinGecko) e cai para demo se falhar.
# "demo" usa somente dados de demonstração.
MARKET_DATA_MODE=live
# Opcional: chave da CoinGecko (plano demo/pro) para limites maiores
COINGECKO_API_KEY=
# Opcional: Alpha Vantage para cotações de ações/ETFs dos EUA
ALPHAVANTAGE_API_KEY=
# Opcional: brapi.dev para cotações da B3
BRAPI_TOKEN=
# Tempo de cache dos provedores (minutos)
MARKET_CACHE_MINUTES=60

# ─── Monitoramento ────────────────────────────────────────────────────────────
# Agendador embutido no processo do Next.js (true/false)
MONITOR_SCHEDULER_ENABLED=true
# Horário UTC (HH:MM) da execução diária — 21:30 UTC ≈ após fechamento B3 e NYSE
MONITOR_DAILY_UTC=21:30
# Segredo para o endpoint /api/cron/monitor (agendadores externos, ex. Vercel Cron)
CRON_SECRET=

# ─── Notificações (opcional) ──────────────────────────────────────────────────
# Sem RESEND_API_KEY, e-mails ficam na fila (outbox) com status "não configurado".
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=alerts@atlas.local
