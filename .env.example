# ---------------------------------------------------------------------------
# Frontend (Vite) — safe to expose. Leave both empty to run the browser-only demo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Edge Function secrets — set with `supabase secrets set KEY=value`.
# NEVER put these in a VITE_* variable or commit them.
#
# Required in every deployment (demo included):
# PASSENGER_DATA_KEY=   # 32 random bytes, base64:  openssl rand -base64 32
# CRON_SECRET=          # shared secret for the pg_cron → monitor-missions call
# APP_URL=https://your-app.example.com
# DEMO_SPEED=60         # demo-mode monitoring acceleration
#
# Live mode (all required, plus provider approval):
# APP_MODE=live
# LIVE_BOOKING_ENABLED=true
# DUFFEL_ACCESS_TOKEN=duffel_live_...
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
#
# Optional:
# RESEND_API_KEY=
# NOTIFICATION_FROM_EMAIL=FareBuddy <alerts@your-domain.com>
# WALLET_PROVIDER_API_KEY=   # custody provider; adapter still to be implemented
